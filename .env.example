# Copy to .env and adjust. Keep real values out of version control (.env is gitignored).
NODE_ENV=development
PORT=3000
# Public origin of the SPA. Must be the real HTTPS origin in production (no localhost).
CLIENT_ORIGIN=http://localhost:3000

# Express `trust proxy`. Set to 1 (or the proxy subnet) when behind a reverse
# proxy so rate limiting sees the real client IP and Secure cookies work.
# Defaults to 1 in production and false otherwise.
TRUST_PROXY=
# Force auth cookies to require HTTPS. Defaults to true in production.
COOKIE_SECURE=
# Max request body size for JSON/urlencoded payloads (multer uploads are separate).
REQUEST_BODY_LIMIT=1mb

# Must match database/schema.sql and setup-smartclass-db.ps1 (database: smartclass)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartclass
# Use a least-privilege user in production (see database/create-app-user.sql).
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# At least 32 random characters. Required (no default) when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Anything jwt understands: 15m, 8h, 7d
JWT_EXPIRES_IN=8h

# Base URL used to build links in emails (defaults to CLIENT_ORIGIN).
APP_BASE_URL=http://localhost:3000

# Optional cache. Caching is bypassed gracefully when Redis is unreachable.
REDIS_URL=redis://localhost:6379

# Rate limiting (per client IP). Window is in milliseconds.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=100

# Email delivery (optional). Leave SMTP_HOST empty to disable email entirely.
# Disabled automatically when NODE_ENV=test. When set, SMTP_USER and SMTP_PASS are required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PHILS LEARNOVA" <no-reply@learnova.example.com>
